.env
.env.*
!.env.example
!**/.env.example
**/vendor/
**/node_modules/
**/.phpunit.cache/
**/.phpunit.result.cache
**/database/*.sqlite*
**/storage/*.key
**/storage/logs/*
!**/storage/logs/.gitignore

